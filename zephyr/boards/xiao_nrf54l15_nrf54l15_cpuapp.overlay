/*
 * Seeed XIAO nRF54L15 (Sense). The Sense's PDM microphone is on pdm20
 * (dmic_dev in the board file), the user button is sw0 and the LED led0.
 *
 * The RRAM keeps the board's standard MCUboot map (nrf54l15_cpuapp_partition.dtsi):
 * mcuboot 62 KB at 0, slot0 712 KB at 0x10000, slot1 712 KB at 0xc2000 and
 * storage (settings) 36 KB at 0x174000. slot1 doubles as the offline clip
 * queue while no firmware update needs it (src/mg_queue.h).
 */

/ {
	zephyr,user {
		/* VBAT through the board's 2:1 divider, switched on by P1.15 (vbat_pwr,
		 * on from boot), on AIN7: channel 7 of the board's ADC node. */
		io-channels = <&adc 7>;
	};
};
