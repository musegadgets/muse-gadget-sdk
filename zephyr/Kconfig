mainmenu "Muse Gadget (Zephyr)"

rsource "Kconfig.mg"

# Device Information Service strings (mgcommands.h). The firmware revision
# is the app version from the VERSION file.
config BT_DIS_FW_REV_STR
	default "$(APPVERSION)"

config BT_DIS_MANUF_NAME_STR
	default "Seeed Studio"

config BT_DIS_MODEL_NUMBER_STR
	default "XIAO nRF54L15"

config BT_DIS_SW_REV_STR
	default "mg1"

# The connection parameters GAP advertises (Peripheral Preferred Connection
# Parameters) are the ones mg_connparam.c asks for.
config BT_PERIPHERAL_PREF_MIN_INT
	default MG_CONN_INTERVAL_MIN

config BT_PERIPHERAL_PREF_MAX_INT
	default MG_CONN_INTERVAL_MAX

config BT_PERIPHERAL_PREF_LATENCY
	default MG_CONN_LATENCY

config BT_PERIPHERAL_PREF_TIMEOUT
	default MG_CONN_TIMEOUT

source "Kconfig.zephyr"
