/* Flash simulator partitions: settings and the offline clip queue. */

/delete-node/ &slot1_partition;

&flash0 {
	partitions {
		audio_queue_partition: partition@75000 {
			label = "audio-queue";
			reg = <0x00075000 0x00069000>;
		};
	};
};
