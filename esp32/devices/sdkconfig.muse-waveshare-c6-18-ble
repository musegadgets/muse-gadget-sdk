# Waveshare ESP32-C6-Touch-AMOLED-1.8 as a BLE-only musegadgets gadget: load
# after sdkconfig.muse and sdkconfig.muse-waveshare-c6-18. Wi-Fi, Home Link
# setup, the Muse session, the tunnel and OTA never start, which frees the
# internal RAM that kept musegadgets BLE audio off this PSRAM-less board. The
# talk button's audio goes to the Muse app over BLE, or to the offline queue
# while no app is connected. tools/muse/board.sh builds it as "c6ble".
CONFIG_MUSE_GADGET_BLE_AUDIO=y
CONFIG_MUSE_GADGET_BLE_STANDALONE=y
# SBC only (LC3 is floating point, ~85 MIPS on this FPU-less RISC-V core).
# CONFIG_MUSE_GADGET_BLE_LC3 is not set
CONFIG_MUSE_GADGET_BLE_QUEUE=y

# Nothing updates it over the air.
CONFIG_HOMEHUB_OTA_ENABLED=n

# The Wi-Fi and lwIP hot paths in IRAM would only take RAM here.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=n

# Audio streams a notification every 20 ms, so give NimBLE back the pool
# blocks the Wi-Fi board overlay took for the pairing TLS handshake.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=24
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=30
